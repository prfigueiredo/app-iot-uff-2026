# PostgreSQL do histórico (V3), iniciado com docker-compose.yml nesta pasta
DATABASE_URL=postgresql://cpd_user:cpd_pass@127.0.0.1:5433/cpd_monitor
# postgres ou memoria (sem banco: o histórico some ao reiniciar)
ARMAZENAMENTO=postgres
# Minutos de cada média do histórico. 60 = uma média por hora
HISTORICO_INTERVALO_MIN=60
SECRET_KEY=troque-esta-chave-em-producao
MODO_SIMULACAO=true

# Condições de alerta
TEMPERATURA_ATENCAO_C=26
LIMITE_TEMPERATURA_C=28
HISTERESE_TEMPERATURA_C=0.5
UMIDADE_ATENCAO_PCT=60
UMIDADE_CRITICA_PCT=70
HISTERESE_UMIDADE_PCT=2
SENSOR_SEM_COMUNICACAO_S=60

# FIWARE Orion (ver ../fiware/docker-compose.yml)
FIWARE_URL=http://127.0.0.1:1026
FIWARE_ENTIDADE_AR_CONDICIONADO=urn:ngsi-ld:ArCondicionado:cpd-01
FIWARE_INTERVALO_S=2

# Preencha quando tiver acesso real ao ambiente do CPD
GRAYLOG_URL=
GRAYLOG_TOKEN=
ZABBIX_URL=
ZABBIX_TOKEN=
